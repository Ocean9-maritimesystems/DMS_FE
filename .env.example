# Copy to .env.local (not committed) and fill in. Read at build time: rebuild after a change.

# API base URL (ends in /api). Default: /api on the same site as the app.
REACT_APP_API_URL=https://localhost:7151/api

# Label shown next to the user name, e.g. Local, QA. Leave empty in production.
REACT_APP_ENV_LABEL=Local

# Company name shown in the header and on the login page.
REACT_APP_COMPANY=DMS

# How dashboard/menu links to manuals open: tree (filter the tree) or grid (a list instead of the tree).
REACT_APP_MANUAL_LINK_VIEW=tree
